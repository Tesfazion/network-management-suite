# NetVisor Suite Configuration
# Copy this file to .env and customize as needed

# Server Configuration
PORT=8080
HOST=0.0.0.0
# LAN_IP=192.168.1.100

# Database (choose one)
# DATABASE_PATH=./network.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/network_management_suite
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432   # Postgres server used by npm test (temp DBs are created/dropped automatically; defaults to DATABASE_URL)

# PostgreSQL individual settings (used when DATABASE_URL is not set)
# PG_HOST=localhost
# PG_PORT=5432
# PG_USER=postgres
# PG_PASSWORD=postgres
# PG_DATABASE=network_management_suite

# Security
# AUTH_TOKEN=your-secret-token-here

# Rate Limiting (per client IP per window)
# RATE_LIMIT_MAX=300
# RATE_LIMIT_WINDOW_MS=900000

# CORS (allow external API consumers; empty = same-origin only)
# CORS_ORIGIN=https://your-frontend.example.com

# Logging
# LOG_FORMAT=text      # text | json

# Backups (used by npm run backup)
# BACKUP_DIR=./backups
# BACKUP_KEEP=5

# Performance
# BODY_LIMIT=1mb

# Environment
# NODE_ENV=production

# ==============================================
# ENTERPRISE MONITORING FEATURES (NEW!)
# ==============================================

# Background Monitoring Service
MONITORING_ENABLED=true              # Enable 24/7 automatic device monitoring
MONITORING_INTERVAL=60000            # Check devices every 60 seconds (milliseconds)
MONITORING_FAILS_REQUIRED=3          # Require 3 consecutive failures before declaring device DOWN

# Email Alert System (SMTP)
# Configure these to receive email notifications when devices go down/up
# SMTP_HOST=smtp.gmail.com           # SMTP server hostname
# SMTP_PORT=587                      # SMTP port (587 for TLS, 465 for SSL)
# SMTP_SECURE=false                  # Use SSL/TLS (true for port 465, false for 587)
# SMTP_USER=your-email@gmail.com     # SMTP username (usually your email)
# SMTP_PASS=your-app-password        # SMTP password (use App Password for Gmail)
# SMTP_FROM=Network Monitoring <alerts@company.com>  # From address shown in emails
# ALERT_EMAIL=admin@company.com      # Email address to receive alerts

# Webhook Alert System
# Send alerts to Slack, Discord, Microsoft Teams, or any HTTP webhook
# WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Gmail Setup Instructions:
# 1. Enable 2-Factor Authentication on your Google Account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Generate an App Password for "Mail"
# 4. Use the generated password in SMTP_PASS above

# Slack Webhook Setup:
# 1. Go to https://api.slack.com/apps
# 2. Create a new app or select existing
# 3. Enable "Incoming Webhooks"
# 4. Add webhook to workspace
# 5. Copy webhook URL to WEBHOOK_URL above

# Discord Webhook Setup:
# 1. Go to Server Settings → Integrations → Webhooks
# 2. Create webhook
# 3. Copy webhook URL to WEBHOOK_URL above

# ==============================================
# CHAT ASSISTANT (optional AI upgrade)
# ==============================================
# The chat widget works out of the box with a local, offline assistant
# (how-to answers + live device/VLAN/monitoring data). To upgrade replies
# with an LLM, set BOT_API_KEY to an OpenAI-compatible API key. Replies
# fall back to the local assistant automatically if the API fails.

# BOT_API_KEY=sk-...                      # API key (leave empty/omit to stay local-only)
# BOT_API_URL=https://api.openai.com/v1/chat/completions  # Full chat-completions endpoint
#                                                             # (Azure example: https://YOUR-RESOURCE.openai.azure.com/openai/deployments/DEPLOYMENT/chat/completions?api-version=2024-02-15-preview)
# BOT_MODEL=gpt-4o-mini                   # Model name (Azure: your deployment name)
# BOT_TEMPERATURE=0.4                     # 0.0 - 1.0 creativity
# BOT_MAX_TOKENS=500                      # Max tokens per reply
# BOT_TIMEOUT_MS=20000                    # Request timeout (ms)
# BOT_MAX_HISTORY=12                      # Chat turns sent as context

