# Network Management Suite - systemd unit
#
# Install:
#   sudo useradd --system --home /opt/nms --shell /usr/sbin/nologin nms
#   sudo mkdir -p /opt/nms && sudo chown nms:nms /opt/nms
#   Copy/sync the project into /opt/nms (npm install --omit=dev as the nms user).
#   sudo cp deploy/nms.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now nms
#
# Open http://<server-ip>:8080 and complete the setup wizard.

[Unit]
Description=Network Management Suite
After=network.target

[Service]
Type=simple
User=nms
Group=nms
WorkingDirectory=/opt/nms
# Install node where your distro puts it, e.g. /usr/bin/node
ExecStart=/usr/bin/node server/server.js
Environment=PORT=8080
# HOST defaults to 0.0.0.0 so the suite is reachable on your LAN.
# Restart=on-failure
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target